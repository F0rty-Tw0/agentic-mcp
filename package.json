{
  "name": "agentic-mcp",
  "version": "0.1.0",
  "description": "Config-driven MCP server that wraps any agentic CLI tool",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "bin": {
    "agentic-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "providers.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:runtime",
    "cross-spawn": "catalog:runtime",
    "which": "catalog:runtime",
    "zod": "catalog:runtime"
  },
  "devDependencies": {
    "@types/cross-spawn": "catalog:build",
    "@types/node": "catalog:build",
    "tsx": "catalog:build",
    "typescript": "catalog:build",
    "eslint": "catalog:lint",
    "eslint-config-prettier": "catalog:lint",
    "lint-suite": "catalog:lint"
  },
  "engines": {
    "node": ">=22"
  }
}
