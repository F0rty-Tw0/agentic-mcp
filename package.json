{
  "name": "agentic-mcp",
  "version": "0.1.0",
  "description": "Multi-model AI gateway — query any CLI AI tool through MCP",
  "license": "MIT",
  "author": "Artiom Tofan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F0rty-Tw0/agentic-mcp.git"
  },
  "homepage": "https://github.com/F0rty-Tw0/agentic-mcp#readme",
  "bugs": {
    "url": "https://github.com/F0rty-Tw0/agentic-mcp/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "bin": {
    "agentic-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --list-different .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --max-warnings 0 . --fix",
    "test": "vitest run --reporter=dot",
    "test:integration": "vitest run --reporter=dot --config vitest.config.integration.ts",
    "validate:providers": "tsx src/config/validate-providers.ts",
    "prepublishOnly": "pnpm run format && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:integration && pnpm run build",
    "publish:pnpm": "pnpm run prepublishOnly && pnpm publish --provenance"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:runtime",
    "cross-spawn": "catalog:runtime",
    "which": "catalog:runtime",
    "zod": "catalog:runtime"
  },
  "devDependencies": {
    "@types/cross-spawn": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "esbuild": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-config-prettier": "catalog:dev",
    "lint-suite": "catalog:dev",
    "prettier": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "agent",
    "ai",
    "claude",
    "codex",
    "copilot",
    "gemini"
  ]
}
