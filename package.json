{
  "name": "agentic-mcp",
  "version": "0.1.0",
  "description": "Config-driven MCP server that wraps any agentic CLI tool",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "bin": {
    "agentic-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "validate:providers": "node --experimental-strip-types src/config/validate-providers.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --max-warnings 0 . --fix",
    "prepublishOnly": "pnpm run test && pnpm run typecheck && pnpm run lint && pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:runtime",
    "cross-spawn": "catalog:runtime",
    "which": "catalog:runtime",
    "zod": "catalog:runtime"
  },
  "devDependencies": {
    "@types/cross-spawn": "catalog:dev",
    "@types/node": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-config-prettier": "catalog:dev",
    "prettier": "catalog:dev",
    "esbuild": "catalog:dev",
    "lint-suite": "catalog:dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "agent",
    "ai",
    "claude",
    "codex",
    "copilot",
    "gemini"
  ]
}
