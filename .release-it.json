{
  "git": {
    "commit": true,
    "commitMessage": "chore(release): 🔖 v${version}",
    "tag": true,
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "push": true,
    "requireBranch": "master",
    "requireCleanWorkingDir": true
  },
  "npm": {
    "publish": false,
    "skipChecks": true
  },
  "github": {
    "release": true,
    "releaseName": "v${version}"
  },
  "hooks": {
    "before:init": "pnpm run ci",
    "after:bump": "node build.mjs",
    "after:git:release": "pnpm publish --provenance --access public --no-git-checks"
  },
  "plugins": {
    "@release-it/keep-a-changelog": {
      "filename": "CHANGELOG.md",
      "head": "Unreleased",
      "addUnreleased": true,
      "addVersionUrl": true,
      "versionUrlFormats": {
        "repositoryUrl": "https://github.com/F0rty-Tw0/agentic-mcp",
        "unreleasedUrl": "{repositoryUrl}/compare/v{tagName}...HEAD",
        "versionUrl": "{repositoryUrl}/compare/v{previousTag}...v{tagName}",
        "firstVersionUrl": "{repositoryUrl}/releases/tag/v{tagName}"
      }
    }
  }
}
