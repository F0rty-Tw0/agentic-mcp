{
  "$schema": "./providers.schema.json",
  "configVersion": 1,
  "providers": {
    "claude": {
      "enabled": true,
      "description": "Claude Code CLI (Anthropic) — autonomous coding agent",
      "command": "claude",
      "timeout": 1800000,
      "env": { "CLAUDECODE": "" },
      "outputFormat": "json",
      "commands": {
        "ask": {
          "args": ["-p"],
          "trailingArgs": ["--output-format", "json"],
          "flags": {
            "model": "--model",
            "autoMode": {
              "flag": "--permission-mode",
              "values": ["acceptEdits", "bypassPermissions", "default", "delegate", "dontAsk", "plan"]
            },
            "effort": {
              "flag": "--effort",
              "values": ["low", "medium", "high"]
            },
            "maxBudget": "--max-budget-usd",
            "systemPrompt": "--system-prompt",
            "workingDir": "--add-dir",
            "file": null
          },
          "streaming": {
            "trailingArgs": ["--verbose", "--output-format", "stream-json"],
            "outputFormat": "stream-json"
          }
        },
        "sessions": {
          "flags": {
            "resume": ["--resume"],
            "continue": ["--continue"]
          }
        }
      },
      "input": { "method": "flag" }
    },
    "codex": {
      "enabled": true,
      "description": "OpenAI Codex CLI — AI coding assistant with session management",
      "command": "codex",
      "timeout": 1800000,
      "env": {},
      "outputFormat": "json",
      "commands": {
        "ask": {
          "args": ["exec"],
          "trailingArgs": ["--full-auto", "--json"],
          "flags": {
            "model": "-m",
            "workingDir": "-C",
            "file": "--image",
            "sandbox": {
              "flag": "--sandbox",
              "values": ["read-only", "workspace-write", "danger-full-access"]
            }
          }
        },
        "review": {
          "args": ["review"],
          "flags": {
            "uncommitted": ["--uncommitted"],
            "base": "--base",
            "commit": "--commit",
            "model": "-m"
          }
        },
        "sessions": {
          "flags": {
            "resume": ["exec", "resume"],
            "continue": ["exec", "resume", "--last"]
          }
        }
      },
      "input": { "method": "positional" }
    },
    "copilot": {
      "enabled": true,
      "description": "GitHub Copilot CLI — AI pair programmer",
      "command": "copilot",
      "timeout": 1800000,
      "idleTimeout": 30000,
      "env": {},
      "outputFormat": "text",
      "commands": {
        "ask": {
          "args": ["-p"],
          "trailingArgs": [
            "--allow-all",
            "--disable-builtin-mcps",
            "--no-ask-user",
            "--max-autopilot-continues",
            "50",
            "-s",
            "--no-color"
          ],
          "flags": {
            "model": "--model",
            "autoMode": ["--yolo"],
            "workingDir": "--add-dir"
          }
        },
        "sessions": {
          "flags": {
            "resume": ["--resume"],
            "continue": ["--continue"]
          }
        }
      },
      "input": { "method": "flag" }
    },
    "gemini": {
      "enabled": true,
      "description": "Google Gemini CLI — large-context AI assistant",
      "command": "gemini",
      "timeout": 1800000,
      "env": {},
      "outputFormat": "json",
      "commands": {
        "ask": {
          "args": ["-p"],
          "trailingArgs": ["--output-format", "json"],
          "flags": {
            "model": "-m",
            "autoMode": ["-y"]
          }
        }
      },
      "input": { "method": "flag" }
    },
    "opencode": {
      "enabled": true,
      "description": "OpenCode — multi-model CLI coding assistant",
      "command": "opencode",
      "timeout": 1800000,
      "env": {},
      "outputFormat": "json",
      "commands": {
        "ask": {
          "args": ["run"],
          "trailingArgs": ["--format", "json"],
          "flags": {
            "model": "-m",
            "file": "--file"
          }
        },
        "models": {
          "args": ["models"]
        },
        "sessions": {
          "flags": {
            "continue": ["--continue"]
          }
        }
      },
      "input": { "method": "positional" }
    }
  }
}
